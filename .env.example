# Server
PORT=3000
DATABASE_PATH=./data/app.sqlite

# Admin API (send as "Authorization: Bearer <ADMIN_API_KEY>")
ADMIN_API_KEY=change-me

# WhatsApp Cloud API (Meta app settings)
WHATSAPP_VERIFY_TOKEN=change-me-too
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Only for `npm run seed`
SEED_WHATSAPP_PHONE_NUMBER_ID=
SEED_WHATSAPP_ACCESS_TOKEN=
